---
import Default from '@astrojs/starlight/components/Head.astro'
import { ClientRouter } from 'astro:transitions'
---

<ClientRouter />
<Default />

<script>
  // Code styles come as a stylesheet link inside the first code block of an MDX page. ClientRouter waits
  // only for head stylesheets before it swaps, so move the link there and wait for it too: no unstyled flash.
  document.addEventListener('astro:before-preparation', (event) => {
    const load = event.loader
    event.loader = async () => {
      await load()
      const page = event.newDocument
      const links = [...page.body.querySelectorAll<HTMLLinkElement>('link[rel=stylesheet]')]
      page.head.append(...links)
      const fresh = links.filter((link) => !document.querySelector(`link[rel=stylesheet][href="${link.getAttribute('href')}"]`))
      await Promise.all(
        fresh.map(
          (link) =>
            new Promise((done) => {
              const preload = Object.assign(document.createElement('link'), { rel: 'preload', as: 'style', href: link.href })
              preload.onload = preload.onerror = done
              document.head.append(preload)
            }),
        ),
      )
    }
  })
</script>

<script>
  // Sections that moved off a page to their own page: old links with the anchor still land on them.
  const MOVED: Record<string, Record<string, string>> = {
    '/gantt/': {
      stages: '/gantt/stages/',
      'people-on-stages': '/gantt/stages/',
      columns: '/gantt/columns-and-filters/',
      'filters-and-views': '/gantt/columns-and-filters/',
      'working-days': '/gantt/working-time/',
      'time-off': '/gantt/working-time/',
      workload: '/gantt/working-time/',
    },
  }
  const follow = () => {
    const anchor = location.hash.slice(1)
    const page = MOVED[location.pathname]?.[anchor]
    if (page) location.replace(`${page}#${anchor}`)
  }
  document.addEventListener('astro:page-load', follow)
  // A hash typed on the page itself changes it without a page load.
  addEventListener('hashchange', follow)
</script>

<script>
  // Starlight restores groups the reader collapsed; keep the current page's group open anyway.
  document.addEventListener('astro:page-load', () => {
    let node = document.querySelector('#starlight__sidebar a[aria-current="page"]')?.parentElement
    while (node) {
      if (node instanceof HTMLDetailsElement) node.open = true
      node = node.parentElement
    }
  })
</script>

<script>
  // Click a clip or a still marked data-zoom: it grows from its place to most of the screen; a click or Esc puts it back.
  const EASE = { duration: 320, easing: 'cubic-bezier(.2,.8,.2,1)' }

  function open(source: HTMLImageElement | HTMLVideoElement) {
    const motion = matchMedia('(prefers-reduced-motion: reduce)').matches ? { duration: 0 } : EASE
    const from = source.getBoundingClientRect()
    const ratio = from.width / from.height
    let w = innerWidth * 0.88
    let h = w / ratio
    if (h > innerHeight * 0.85) {
      h = innerHeight * 0.85
      w = h * ratio
    }
    const left = (innerWidth - w) / 2
    const top = (innerHeight - h) / 2

    const overlay = document.createElement('div')
    overlay.className = 'tiko-lightbox'
    const media = source.cloneNode(false) as HTMLImageElement | HTMLVideoElement
    media.removeAttribute('data-zoom')
    media.className = 'tiko-lightbox-media'
    Object.assign(media.style, { left: `${left}px`, top: `${top}px`, width: `${w}px`, height: `${h}px` })
    if (media instanceof HTMLVideoElement && source instanceof HTMLVideoElement) {
      media.muted = true
      media.loop = true
      media.preload = 'auto'
      media.currentTime = source.currentTime
      media.play().catch(() => {})
    }
    const backdrop = document.createElement('div')
    backdrop.className = 'tiko-lightbox-backdrop'
    overlay.append(backdrop, media)
    document.body.append(overlay)
    source.style.visibility = 'hidden'

    const frames = [
      { transform: `translate(${from.left - left}px, ${from.top - top}px) scale(${from.width / w})` },
      { transform: 'none' },
    ]
    const shade = [{ opacity: 0 }, { opacity: 1 }]
    media.animate(frames, motion)
    backdrop.animate(shade, motion)

    const close = () => {
      document.removeEventListener('keydown', onKey)
      overlay.removeEventListener('click', close)
      const back = source.getBoundingClientRect()
      frames[0].transform = `translate(${back.left - left}px, ${back.top - top}px) scale(${back.width / w})`
      media.animate([...frames].reverse(), { ...motion, fill: 'forwards' })
      backdrop.animate([...shade].reverse(), { ...motion, fill: 'forwards' }).onfinish = () => {
        overlay.remove()
        source.style.visibility = ''
      }
    }
    const onKey = (event: KeyboardEvent) => event.key === 'Escape' && close()
    overlay.addEventListener('click', close)
    document.addEventListener('keydown', onKey)
  }

  document.addEventListener('click', (event) => {
    const target = (event.target as Element).closest?.('[data-zoom]')
    if (target instanceof HTMLImageElement || target instanceof HTMLVideoElement) {
      event.preventDefault()
      open(target)
    }
  })
</script>

<script>
  // Marks the box being scrolled for a second, so its thin scrollbar shows and then fades (tiko.css).
  const timers = new WeakMap<Element, number>()
  document.addEventListener(
    'scroll',
    (event) => {
      const box = event.target instanceof Element ? event.target : document.documentElement
      box.classList.add('tiko-scrolling')
      clearTimeout(timers.get(box))
      timers.set(box, window.setTimeout(() => box.classList.remove('tiko-scrolling'), 1000))
    },
    { capture: true, passive: true },
  )
</script>

<script>
  // API reference: each response folds under its status, coloured by class; only success stays open.
  const fold = () => {
    const heading = document.getElementById('responses')?.closest('.sl-heading-wrapper')
    let node = heading?.nextElementSibling
    while (node?.matches('section.sl-openapi-section')) {
      const section = node
      node = node.nextElementSibling
      if (section.querySelector(':scope > .tiko-response')) continue
      const title = section.querySelector(':scope > .sl-heading-wrapper')
      const status = title?.querySelector('h3')?.id ?? ''
      const box = document.createElement('details')
      box.className = 'tiko-response'
      box.dataset.status = /^[1-5]/.test(status) ? `${status[0]}xx` : 'default'
      box.open = status.startsWith('2')
      const summary = document.createElement('summary')
      summary.append(...[title, section.querySelector(':scope > .sl-openapi-section-pre-panel')].filter((el) => el !== null))
      box.append(summary, ...section.children)
      section.append(box)
    }
    reveal()
  }
  // A link to one status, from the page's contents or elsewhere, opens it.
  const reveal = () => {
    const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)))
    const box = target ? target.closest('details.tiko-response') : null
    if (box instanceof HTMLDetailsElement) box.open = true
  }
  document.addEventListener('astro:page-load', fold)
  addEventListener('hashchange', reveal)
</script>
