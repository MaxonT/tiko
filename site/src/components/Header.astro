---
import { DEMO, DOCS, FEATURE_PAGES, REPO, ROADMAP, USE_CASE_PAGES } from '../data/site'
import Brand from './Brand.astro'
import Icon from './Icon.astro'
import Mark from './Mark.astro'
import ThemeSwitch from './ThemeSwitch.astro'

const groups = [
  { title: 'Features', pages: FEATURE_PAGES, wide: true },
  { title: 'Use cases', pages: USE_CASE_PAGES },
]
---

<header class="header">
  <div class="wrap row">
    <a class="home" href="/" aria-label="tiko, home"><Brand height={26} /></a>
    <nav aria-label="Main">
      <div class="menu" data-menu>
        <button type="button" class="trigger" aria-expanded="false" aria-controls="features-menu">
          Features <Icon name="chevron-down" size={14} />
        </button>
        <div class="panel" id="features-menu">
          <div class="groups">
            {
              groups.map(({ title, pages, wide }) => (
                <div class:list={['col', { wide }]}>
                  <p class="group">{title}</p>
                  <ul>
                    {pages.map(({ href, title, text, icon }) => (
                      <li>
                        <a class="item" {href}>
                          <span class="glyph"><Icon name={icon} size={18} /></span>
                          <span><b>{title}</b><small>{text}</small></span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          <a class="all" href="/#features">All features <Icon name="arrow-right" size={14} /></a>
        </div>
      </div>
      <a href="/#scenarios">Scenarios</a>
      <a href="/#self-host">Self-host</a>
      <a href={`${DOCS}/`}>Docs</a>
      <a href={ROADMAP}>Roadmap</a>
    </nav>
    <div class="side">
      <a class="github" href={REPO} aria-label="tiko on GitHub"><Mark tracker="github" size={18} /><span>GitHub</span></a>
      <ThemeSwitch />
      <a class="btn btn-primary btn-sm" href={DEMO}>Try the demo</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 70%, transparent);
    background: color-mix(in oklch, var(--background) 82%, transparent);
    backdrop-filter: blur(12px);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 3.75rem;
  }
  .home {
    display: flex;
    color: var(--foreground);
  }
  nav {
    display: flex;
    gap: 0.25rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  nav > a,
  .trigger {
    padding: 0.375rem 0.625rem;
    border-radius: 6px;
  }
  nav > a:hover,
  .trigger:hover,
  .menu.open .trigger,
  .github:hover {
    color: var(--foreground);
    background: var(--muted);
  }
  .menu {
    position: relative;
  }
  .trigger {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .trigger :global(svg) {
    transition: transform 0.15s;
  }
  .menu:hover .trigger :global(svg),
  .menu:focus-within .trigger :global(svg),
  .menu.open .trigger :global(svg) {
    transform: rotate(180deg);
  }
  .menu.closed .trigger :global(svg) {
    transform: none;
  }
  /* An invisible bridge keeps the menu open while the pointer crosses the gap to it. */
  .panel {
    position: absolute;
    top: 100%;
    left: -0.5rem;
    width: 46rem;
    padding-top: 0.5rem;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
  }
  .menu:hover .panel,
  .menu:focus-within .panel,
  .menu.open .panel {
    visibility: visible;
    opacity: 1;
    transform: none;
  }
  .menu.closed .panel {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
  }
  .groups {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-bottom: 0;
    border-radius: 12px 12px 0 0;
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .wide ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .col + .col {
    padding-left: 0.5rem;
    border-left: 1px solid var(--border);
  }
  .group {
    padding: 0.25rem 0.5rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }
  .item {
    display: flex;
    gap: 0.75rem;
    padding: 0.5rem;
    border-radius: 8px;
    color: var(--foreground);
  }
  .item:hover,
  .item:focus-visible {
    background: var(--muted);
  }
  .glyph {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
    color: var(--primary);
  }
  .item b {
    display: block;
    font-weight: 600;
  }
  .item small {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--muted-foreground);
  }
  .all {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0 0 12px 12px;
    background: var(--muted);
    box-shadow: var(--shadow);
    font-weight: 500;
    color: var(--foreground);
  }
  .all:hover {
    color: var(--primary);
  }
  .side {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }
  .github {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding-inline: 0.625rem;
    border-radius: 8px;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .github :global(svg) {
    color: var(--foreground);
  }
  .side .btn {
    margin-left: 0.5rem;
  }
  @media (max-width: 860px) {
    nav {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .github span {
      display: none;
    }
  }
</style>

<script>
  // The menu opens on hover and focus without scripts. This adds a tap toggle for touch screens,
  // keeps aria-expanded in step and closes it on Escape; `.closed` beats hover and focus until
  // the pointer and focus have both left.
  for (const menu of document.querySelectorAll<HTMLElement>('[data-menu]')) {
    const trigger = menu.querySelector('button')!
    const shown = () => !menu.classList.contains('closed') && menu.matches('.open, :hover, :focus-within')
    const sync = () => trigger.setAttribute('aria-expanded', String(shown()))
    const close = () => {
      menu.classList.remove('open')
      menu.classList.add('closed')
      sync()
    }
    trigger.addEventListener('click', () => {
      // Hover or focus may show the menu already; a click pins it open, the next one closes it.
      if (menu.classList.contains('open')) return close()
      menu.classList.remove('closed')
      menu.classList.add('open')
      sync()
    })
    for (const type of ['mouseenter', 'mouseleave', 'focusin', 'focusout'])
      menu.addEventListener(type, () =>
        requestAnimationFrame(() => {
          if (!menu.matches(':hover, :focus-within')) menu.classList.remove('closed')
          sync()
        }),
      )
    document.addEventListener('click', (event) => {
      if (menu.contains(event.target as Node)) return
      menu.classList.remove('open')
      sync()
    })
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      close()
      trigger.focus()
    })
  }
</script>
