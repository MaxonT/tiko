---
// The hero: a headline made of canvas objects next to the drawn board; phones stack them.
import { DEMO, TRACKERS } from '../data/site'
import BoardSim from './BoardSim.astro'
import Icon from './Icon.astro'
import Install from './Install.astro'
import Logo from './Logo.astro'
import Waitlist from './Waitlist.astro'

// The Cloud waitlist badge is off until the hosted plan is closer; flip to show it again.
const showCloud = false
---

<section class="hero">
  <div class="wrap copy">
    {showCloud && <Waitlist source="hero" />}
    <h1>
      A&nbsp;<span class="w-select">whiteboard<i class="h tl"></i><i class="h tr"></i><i class="h bl"></i><i class="h br"></i></span>
      where your <span class="w-card" data-word><span class="w-type"><Icon name="check" size={12} /></span>tasks</span>
      never go <span class="w-live">stale<i></i></span>
    </h1>
    <p class="sub">
      <b class="tiko">tiko</b> puts tasks from
      <span class="rot" data-rot>
        <span class="sr-only">your tracker</span>
        <span class="rot-box" aria-hidden="true">
          {
            TRACKERS.map((t, i) => (
              <span class:list={['ri', { on: i === 0 }]}>
                <Logo id={t.id} size={20} />
                {t.name}
                {!t.live && <small>soon</small>}
              </span>
            ))
          }
        </span>
      </span>
      on an infinite canvas as live cards.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={DEMO}>Try the demo <Icon name="arrow-right" /></a>
      <Install />
    </div>
  </div>

  <div class="track">
    <div class="wrap">
      <BoardSim />
    </div>
  </div>
</section>

<script>
  // The tracker name in the subtitle rolls up to the next one every few seconds.
  const box = document.querySelector<HTMLElement>('[data-rot] .rot-box')
  if (box && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = [...box.children] as HTMLElement[]
    let at = 0
    setInterval(() => {
      if (document.hidden) return
      const current = items[at]
      // Names that rolled out earlier go back below, out of sight, ready to roll in.
      for (const item of items) if (item !== current) item.classList.remove('off')
      current.classList.replace('on', 'off')
      at = (at + 1) % items.length
      items[at].classList.add('on')
    }, 2200)
  }

  // The task word in the headline drags like a card and springs back.
  const word = document.querySelector<HTMLElement>('[data-word]')
  word?.addEventListener('pointerdown', (down) => {
    if (!down.isPrimary || down.button !== 0) return
    word.setPointerCapture(down.pointerId)
    word.classList.add('held')
    const move = (e: PointerEvent) =>
      word.style.setProperty('translate', `${e.clientX - down.clientX}px ${e.clientY - down.clientY}px`)
    // A cancelled or lost pointer ends the drag the same way a release does.
    const up = () => {
      word.classList.remove('held')
      word.style.removeProperty('translate')
      word.removeEventListener('pointermove', move)
      word.removeEventListener('pointerup', up)
      word.removeEventListener('pointercancel', up)
      word.removeEventListener('lostpointercapture', up)
    }
    word.addEventListener('pointermove', move)
    word.addEventListener('pointerup', up)
    word.addEventListener('pointercancel', up)
    word.addEventListener('lostpointercapture', up)
  })
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2rem, 4.5vw, 3.5rem);
    overflow-x: clip;
  }
  /* The page grid fades out behind the headline, so the text sits on a calm field. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 46rem;
    background: radial-gradient(ellipse 60% 60% at 50% 30%, var(--background) 45%, transparent 100%);
    pointer-events: none;
  }
  .copy {
    position: relative;
    display: grid;
    justify-items: center;
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
    text-align: center;
  }
  h1 {
    max-width: 18ch;
    font-size: clamp(2.25rem, 5.6vw, 3.75rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  /* "whiteboard" is selected, as on the canvas. */
  .w-select {
    position: relative;
    margin-inline: 0.06em 0.14em;
    padding-inline: 0.08em;
    outline: 2px solid var(--primary);
    outline-offset: 0.04em;
    border-radius: 2px;
  }
  .h {
    position: absolute;
    width: 9px;
    height: 9px;
    border: 2px solid var(--primary);
    border-radius: 2px;
    background: var(--card);
  }
  .tl {
    left: -6px;
    top: -6px;
  }
  .tr {
    right: -6px;
    top: -6px;
  }
  .bl {
    left: -6px;
    bottom: -6px;
  }
  .br {
    right: -6px;
    bottom: -6px;
  }

  /* "tasks" is a task card you can pick up. */
  .w-card {
    display: inline-flex;
    align-items: center;
    gap: 0.18em;
    padding: 0 0.22em 0.04em 0.14em;
    border: 1px solid var(--border);
    border-radius: 0.14em;
    background: var(--card);
    box-shadow: var(--shadow);
    cursor: grab;
    touch-action: none;
    rotate: -2deg;
    transition:
      translate 0.5s cubic-bezier(0.3, 1.6, 0.4, 1),
      rotate 0.2s;
  }
  .w-card.held {
    rotate: 2deg;
    cursor: grabbing;
    transition: rotate 0.2s;
  }
  .w-type {
    display: grid;
    place-items: center;
    width: 0.42em;
    height: 0.42em;
    border-radius: 0.07em;
    background: var(--type-task);
    color: white;
  }
  .w-type :global(svg) {
    width: 0.3em;
    height: 0.3em;
    stroke-width: 3.5;
  }

  /* "live" carries the sync dot. */
  .w-live {
    position: relative;
  }
  .w-live i {
    position: absolute;
    right: -0.24em;
    top: 0.2em;
    width: 0.17em;
    height: 0.17em;
    border-radius: 50%;
    background: var(--sync-ok);
    animation: hero-live 1.8s ease-out infinite;
  }
  @keyframes hero-live {
    from {
      box-shadow: 0 0 0 0 color-mix(in oklch, var(--sync-ok) 55%, transparent);
    }
    70%,
    to {
      box-shadow: 0 0 0 0.22em transparent;
    }
  }

  /* The tracker name rolls through the list. All names share one grid cell, so the slot is
     as wide as the longest one and the text around it never moves. */
  .rot {
    display: inline-block;
    margin-inline: 0.5em 0.1em;
    vertical-align: bottom;
  }
  /* On a narrow screen the name gets its own line, so its length never rewraps the rest. */
  @media (max-width: 640px) {
    .rot {
      display: block;
    }
  }
  .rot-box {
    display: inline-grid;
    justify-items: center;
    height: 1.55em;
    overflow: hidden;
    vertical-align: bottom;
  }
  .ri {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    height: 1.55em;
    padding-inline: 0.1em;
    color: var(--foreground);
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    translate: 0 100%;
    transition:
      translate 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.3s;
  }
  .ri.on {
    opacity: 1;
    translate: 0 0;
  }
  .ri.off {
    translate: 0 -100%;
  }
  .ri small {
    padding: 0 0.35em;
    border-radius: 4px;
    background: var(--muted);
    color: var(--muted-foreground);
    font-size: 0.62em;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .sub {
    max-width: 58rem;
    margin-top: 1.25rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--muted-foreground);
    text-wrap: balance;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .track {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  /* Wide screens: copy on the left, the board on the right, both in the first screen. */
  @media (min-width: 960px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: 2.5rem;
      max-width: calc(var(--page) + var(--gutter) * 2);
      margin-inline: auto;
      padding-inline: var(--gutter);
      padding-bottom: clamp(3rem, 6vw, 5rem);
    }
    .hero::before {
      background: radial-gradient(ellipse 50% 60% at 22% 25%, var(--background) 45%, transparent 100%);
    }
    .hero .wrap {
      max-width: none;
      padding-inline: 0;
    }
    .copy {
      justify-items: start;
      margin-bottom: 0;
      text-align: left;
    }
    h1 {
      font-size: clamp(2.5rem, 3.6vw, 3.5rem);
    }
    .rot-box {
      justify-items: start;
    }
    .actions {
      justify-content: flex-start;
    }
    .track {
      padding-bottom: 0;
    }
  }
</style>
